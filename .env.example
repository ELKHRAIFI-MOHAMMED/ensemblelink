# URL du backend Django
#   local  : http://127.0.0.1:8000
#   Vercel : https://<votre-projet-backend>.vercel.app   (sans / final)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Temps réel par WebSocket : uniquement en local (Daphne).
# Sur Vercel, laisser VIDE : la messagerie et les notifications se rafraîchissent automatiquement.
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
