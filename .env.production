# Valeurs utilisées par `next build` en production (Vercel). Rien de secret ici :
# ces variables NEXT_PUBLIC_ sont de toute façon visibles dans le navigateur.
# Une variable définie dans Vercel → Settings → Environment Variables reste prioritaire.
# En local, .env.local (127.0.0.1:8000) passe avant ce fichier.
NEXT_PUBLIC_API_URL=https://back-ensemblelink.vercel.app
# NEXT_PUBLIC_WS_URL non défini : sur Vercel, rafraîchissement automatique au lieu des WebSockets.
